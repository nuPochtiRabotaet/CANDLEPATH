# No credentials required. Shell variables are read explicitly (no automatic .env loading).
HOST=127.0.0.1
PORT=8000
MOEX_CACHE_TTL=300
# MOEX_DATA_DIR=/absolute/path/to/local/portfolio-data
# Crypto uses public Bybit without keys. Never place actual secrets in this file.
# MOEX_PAPER_CAPITAL=10000
# BYBIT_READONLY_KEY=<set in protected process environment>
# BYBIT_READONLY_SECRET=<set in protected process environment>
